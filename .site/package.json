{
  "name": "bitshelf-notebook-site",
  "description": "BitShelf Notebook site configuration for official Quartz releases",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "author": "jackyzha0 <j.zhao2k19@gmail.com>",
  "license": "MIT",
  "homepage": "https://bitshelf.github.io/notebook/",
  "repository": {
    "type": "git",
    "url": "https://github.com/bitshelf/notebook.git"
  },
  "scripts": {
    "quartz": "./quartz/bootstrap-cli.mjs",
    "docs": "npx quartz build --serve -d docs",
    "check": "tsc --noEmit && npx prettier . --check",
    "format": "npx prettier . --write",
    "test": "tsx --test",
    "profile": "0x -D prof ./quartz/bootstrap-cli.mjs build --concurrency=1",
    "install-plugins": "npx tsx ./quartz/plugins/loader/install-plugins.ts",
    "prebuild": "node scripts/check-quartz-vendor.mjs",
    "patch:plugins": "node scripts/patch-plugins.mjs",
    "build": "node scripts/build.mjs",
    "test:site": "node --test scripts/build.test.mjs scripts/github-attachments.test.mjs scripts/vendor.test.mjs scripts/optimize-output.test.mjs",
    "sync:quartz": "node scripts/sync-quartz.mjs",
    "check:vendor": "node scripts/check-quartz-vendor.mjs",
    "patch:core": "node scripts/patch-core.mjs",
    "pretest:site": "node --import tsx scripts/prepare-plugins.mjs",
    "deploy:cloudflare": "npx --yes wrangler@4.158.0 deploy --config wrangler.jsonc"
  },
  "engines": {
    "npm": ">=10",
    "node": ">=22"
  },
  "keywords": [
    "site generator",
    "ssg",
    "digital-garden",
    "markdown",
    "blog",
    "quartz"
  ],
  "bin": {
    "quartz": "./quartz/bootstrap-cli.mjs"
  },
