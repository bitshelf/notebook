  "trashOption": "local",
  "livePreview": true,
  "autoConvertHtml": true,
  "fileSortOrder": "alphabetical",
  "newLinkFormat": "relative",
  "useMarkdownLinks": true,
  "userIgnoreFilters": [
    "pdf/",
    "/.excalidraw.md/",
